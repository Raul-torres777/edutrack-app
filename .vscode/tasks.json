{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar Servidor EduTrack (Node)",
      "type": "shell",
      "command": "node server.js",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Iniciando servidor EduTrack...",
          "endsPattern": "Servidor local corriendo en http://localhost:3000"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Iniciar Servidor EduTrack (Python)",
      "type": "shell",
      "command": "python -m http.server 3000",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Serving HTTP on",
          "endsPattern": "port 3000"
        }
      }
    }
  ]
}
