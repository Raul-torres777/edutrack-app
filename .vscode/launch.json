{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Iniciar EduTrack en Microsoft Edge (con Servidor)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Iniciar Servidor EduTrack (Node)"
    },
    {
      "name": "Iniciar EduTrack en Google Chrome (con Servidor)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Iniciar Servidor EduTrack (Node)"
    },
    {
      "name": "Solo Abrir Edge en http://localhost:3000",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Adjuntar Depurador a Navegador (Puerto 9222)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}"
    }
  ]
}
